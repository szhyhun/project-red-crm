BOARD_MEDIA_MAX_BYTES=524288000
# Chat attachments are private and use the authorized API preview/download
# routes. Leave blank locally to store files under storage/chat_media.
PROJECT_RED_CHAT_MEDIA_BUCKET=
CHAT_MEDIA_MAX_BYTES=524288000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
